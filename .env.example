NODE_ENV=development
HOST=localhost
PORT=4000
API_PREFIX=/api/v1

MONGODB_URI=mongodb://localhost:27017/nemkit_inventory
MONGODB_TLS=false
MONGODB_TLS_ALLOW_INVALID=false
MONGODB_USE_SERVER_API=false

JWT_SECRET=replace-with-a-local-secret
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=replace-with-a-local-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:4200

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

LOG_LEVEL=info
LOGS_LOCAL_PATH=./logs

ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-a-local-admin-password
ADMIN_FULLNAME=Local Admin
