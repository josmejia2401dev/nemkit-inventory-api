NODE_ENV=development
HOST=localhost
PORT=4000
API_PREFIX=/api/v1/inventory

# Nombre lógico del nodo que reporta /ready y /health ("casa" o "render").
# Sirve para detectar proxies mal enrutados desde el frontend.
APP_NODE_NAME=

MONGODB_URI=mongodb://localhost:27017/nemkit_inventory
MONGODB_TLS=false
MONGODB_TLS_ALLOW_INVALID=false
MONGODB_USE_SERVER_API=false

JWT_SECRET=replace-with-a-local-secret
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=replace-with-a-local-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:4200

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

LOG_LEVEL=info
LOGS_LOCAL_PATH=./logs

ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-a-local-admin-password
ADMIN_FULLNAME=Local Admin
# Correo transaccional OTP vía Notify interno
NOTIFY_API_URL=
NOTIFY_API_KEY=
OTP_TTL_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_SECRET=

# Cache Redis (Render Key Value)
REDIS_URL=
REDIS_ENABLED=true
CACHE_PREFIX=nk:inventory
CACHE_VERSION=v1
REDIS_CONNECT_TIMEOUT_MS=1500
REDIS_COMMAND_TIMEOUT_MS=100
REDIS_CIRCUIT_FAILURES=3
REDIS_CIRCUIT_OPEN_MS=60000
REDIS_PROBE_INTERVAL_MS=30000
CACHE_TTL_API_KEY_SECONDS=30
CACHE_TTL_DETAIL_SECONDS=300
CACHE_TTL_CATALOG_SECONDS=120
CACHE_TTL_DASHBOARD_SECONDS=30
CACHE_TTL_STATS_SECONDS=30
